{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://sheets-activation-prisoners-stanford.trycloudflare.com/health"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sheets-activation-prisoners-stanford.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://sheets-activation-prisoners-stanford.trycloudflare.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
