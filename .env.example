# ==============================================================================
# WATCH PARTY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the production or development server
# ==============================================================================

# Server listener port (e.g. 3001 locally, or dynamically assigned by host)
PORT=3001

# Allowed Client Origins for CORS (comma-separated if multiple, e.g. https://syncscreen-vv.vercel.app)
CLIENT_URL=http://localhost:5173

# Node runtime environment (development | production)
NODE_ENV=production

# Optional: External Backend Base URL for Decoupled Frontend (Vercel) Deployment
# Leave empty for unified single-service deployments (Render, Docker, Railway, Fly.io)
VITE_SERVER_URL=

# Optional: TMDB Movie Catalog API Key (If omitted, rich local creative-commons cinema catalog is used)
TMDB_API_KEY=
